# Village Docker Environment Configuration
# Copy this file to /opt/village/config/village.env and edit the values

# ============================================================================
# SAFETY CHECK - DELETE THIS LINE AFTER EDITING CONFIG
# ============================================================================
# The application will refuse to start while this variable is set.
# Delete or comment out this line after you've reviewed and edited the required settings below.
CONFIG_NOT_REVIEWED=true

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Flask secret key for session encryption
# IMPORTANT: Generate a random 32+ character string
# You can generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE_ME

# Flask environment (should be 'production' for deployment)
FLASK_ENV=production

# Village repository data directory (mounted volume inside container)
VILLAGE_REPOSITORY=/opt/village/data

# ============================================================================
# GUNICORN SERVER CONFIGURATION
# ============================================================================

# Bind address (inside container, don't change unless you know what you're doing)
BIND_ADDRESS=0.0.0.0:8000

# Number of worker processes (adjust based on your CPU cores)
# Rule of thumb: (2 x num_cores) + 1
WORKERS=4

# Worker class (gevent for async I/O)
WORKER_CLASS=gevent

# Maximum number of simultaneous connections per worker
WORKER_CONNECTIONS=1000

# Restart workers after this many requests (prevents memory leaks)
MAX_REQUESTS=1000

# Add random jitter to MAX_REQUESTS to prevent all workers restarting at once
MAX_REQUESTS_JITTER=50

# Worker timeout in seconds (increase if you have long-running requests)
TIMEOUT=30

# Logging level: debug, info, warning, error, critical
LOG_LEVEL=info

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Uncomment and set if you need to customize these paths
# (usually not needed, defaults are fine)

# LOG_DIR=/opt/village/logs
# ACCESS_LOG=/opt/village/logs/access.log
# ERROR_LOG=/opt/village/logs/error.log
