# Village (Python implementation) environment configuration
# Copy this file to /etc/village.env and configure

# Flask configuration
FLASK_SECRET_KEY="CHANGE_THIS_TO_A_RANDOM_32_CHARACTER_STRING_12345678"
FLASK_ENV=production

# Village repository configuration
VILLAGE_REPOSITORY_PATH=/opt/village/data

# Gunicorn configuration
BIND_ADDRESS=127.0.0.1:8000
WORKERS=4
WORKER_CLASS=gevent
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
TIMEOUT=30

# Logging
LOG_LEVEL=info